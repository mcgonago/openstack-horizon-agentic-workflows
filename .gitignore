# Review and analysis artifacts — generated output, not source
artifacts/
# But keep verify artifacts (source of truth for dashboard [src] links)
!workflows/verify/artifacts/

# Claude Code project-specific state (not shared across machines)
.claude/
# But keep workflow-specific skills (source of truth for skill definitions)
!workflows/*/.claude/
!workflows/*/.claude/skills/
!workflows/*/.claude/skills/**

# OS / editor noise
.DS_Store
*.swp
*.swo
__pycache__/
*.pyc
